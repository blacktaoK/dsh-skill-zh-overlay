    "dsh-skill-mcp-panel"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blacktaoK/dsh-skill-zh-overlay.git"
  },
  "bugs": {
