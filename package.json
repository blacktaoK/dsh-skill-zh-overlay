{
  "name": "dsh-skill-zh-overlay",
  "version": "1.2.0",
  "description": "给 dsh-skill-mcp-panel 的技能卡片加一块中文说明。没收录的英文技能由宿主调用当前默认模型现场生成并缓存（按原文 sha1 失效），原文是中文的自动跳过，面板原本的英文原文折进「原文」按钮。装完即用，不必逐条手写映射。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "skill",
    "i18n",
    "chinese",
    "dsh-skill-mcp-panel",
    "translation",
    "llm"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blacktaoK/dsh-skill-zh-overlay.git"
  },
  "bugs": {
    "url": "https://github.com/blacktaoK/dsh-skill-zh-overlay/issues"
  },
  "homepage": "https://github.com/blacktaoK/dsh-skill-zh-overlay#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "data",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/test-installer.mjs && node test/test-auto.mjs",
    "test:installer": "node test/test-installer.mjs",
    "test:auto": "node test/test-auto.mjs",
    "smoke": "node test/smoke.mjs"
  }}
